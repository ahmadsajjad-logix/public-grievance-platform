# Optional developer-only OpenAI adapter; the Voice screen needs no API key.
# Set these as environment variables. Never commit keys.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Optional Unicode TrueType font for Urdu PDFs (e.g. Noto Naskh Arabic).
PETITION_FONT_PATH=
# Multilingual server-side speech model: base (default) or small (more memory).
WHISPER_MODEL_SIZE=base
